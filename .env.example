# Environment configuration for local GPU server
# Copy this file to .env and adjust values

# --- Core ---
LOG_LEVEL=INFO
GPU_ENABLED=True
GPU_DEVICE_ID=0

# --- Embedding ---
USE_TULIP=True
USE_FP16=True
UNIFIED_DIM=768

# --- Model Directories (offline / local) ---
# Set to local path (e.g. models/vinai-translate-vi2en-v2) for offline mode.
# Leave empty to auto-download from HuggingFace / open_clip cache.
VI_EN_TRANSLATION_MODEL_DIR=
CROSS_ENCODER_MODEL_DIR=
OPENCLIP_MODEL_DIR=

# --- Self-hosted VLM (Qwen2.5-VL-32B-Instruct-AWQ via vLLM) ---
# Start the server: bash scripts/serve_vlm.sh
# VRAM budget: ~34GB on A100 80GB (weights 16GB + KV cache 16GB + overhead 2GB)
VLM_ENABLED=True
VLM_URL=http://localhost:8080
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct-AWQ
VLM_TIMEOUT_SEC=120.0
VLM_MAX_FRAMES=10

# --- Contest Pipeline ---
TOPK_VIDEOS=20
TRAKE_VIDEOS=50
DELTA_RATIO=0.05
FRAME_STEP=5
MAX_ROWS=100
