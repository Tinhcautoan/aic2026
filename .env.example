# Copy this file to .env and fill in what your machine actually needs.
# config/settings.py already has sane defaults for everything else -- only
# override what's genuinely machine/dataset-specific.

# ---------------- Paths ----------------
# Where your source .mp4 files live (scripts/setup_local.py + live frame/
# video serving read from here). Defaults to data/videos if unset.
VIDEO_DIR=C:/path/to/your/videos

# HuggingFace model cache. Defaults to ./hf-cache (project-relative) so a
# first run can't silently fill a small system drive -- point this at a
# roomier drive (or an existing cache) if you have one. Models total
# ~15-20GB (PE-Core, SigLIP2, translator, cross-encoder).
HF_HOME=D:/hf-cache

# ---------------- Second dense encoder ("siglip2" slot) ----------------
# False (default) = SigLIP2 (ViT-SO400M-14-SigLIP2, 1152-dim native).
# True = C2LIP, a fine-tuned SigLIP ViT-B/16 checkpoint (768-dim). Only
# turn this on if you have your OWN c2lipweight.pt + embeddings_c2lip.pkl --
# these are ~1.2GB + ~1GB and are NOT in this repo (see .gitignore); ask
# whoever has them directly (Drive/Zalo/USB), don't expect `git pull` to
# bring them. The field names stay "siglip2_*" everywhere either way.
USE_C2LIP=False

# Only relevant when USE_C2LIP=True and the paths aren't the defaults
# (repo root / "c2lipweight.pt" and "embedding finvit + c2lip/embeddings_c2lip.pkl"):
# C2LIP_CHECKPOINT=E:/path/to/c2lipweight.pt
# C2LIP_EMBEDDINGS_PKL=E:/path/to/embeddings_c2lip.pkl

# If the precomputed corpus embeddings you were handed were built with
# SigLIP2 truncated to 768 dims (an older setup), pin these so they keep
# loading without a re-embed. Leave both unset on a fresh setup --
# native/1152 is the better default.
# SIGLIP2_PROJECTION_MODE=truncate
# EMBEDDING_DIM_SIGLIP2_STORED=768

# ---------------- Optional: VLM for Q&A answers ----------------
# GEMINI_ENABLED=True
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash

# ---------------- Optional: contest media-info JSON ----------------
# If BTC provides OCR/ASR/object/title metadata, BM25 + the cross-encoder
# can use it -- point this at the folder that contains it:
# MEDIA_INFO_DIR=E:/path/to/media-info-aic25-b1/media-info

# ---------------- Optional: tight VRAM ----------------
# CROSS_ENCODER_ENABLED=False
